# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/finwise?retryWrites=true&w=majority"

# Long random string used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used in invite messages)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
